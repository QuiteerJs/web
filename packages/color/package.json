{
  "name": "@quiteer/color",
  "version": "0.0.1",
  "description": "一个基于 colord 的颜色生成库",
  "exports": {
    ".": "./src/index.ts"
  },
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "publishConfig": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      }
    },
    "access": "public",
    "registry": "https://registry.npmjs.org/"

  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsdown --watch",
    "build": "tsdown",
    "release": "qui r --tag-prefix color && tsdown && pnpm publish --access public"
  },
  "dependencies": {
    "colord": "^2.9.3"
  }
}
